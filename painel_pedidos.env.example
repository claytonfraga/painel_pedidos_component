# Configuracao do Painel de Acompanhamento de Pedidos.
# OBRIGATORIA no uso do componente: copie para painel_pedidos.env.
# As quatro chaves de SLA por estado sao obrigatorias.

# SLA fixo por estado, em minutos.
SLA_NOVO_MINUTOS=5
SLA_EM_PREPARO_MINUTOS=20
SLA_PRONTO_PARA_ENTREGA_MINUTOS=10
SLA_EM_ROTA_DE_ENTREGA_MINUTOS=10

# Intervalo de avaliacao do monitor de SLA (segundos).
SLA_MONITOR_INTERVALO_SEGUNDOS=30

# Duracao da mensagem/destaque de novo pedido (segundos).
NOTIFICACAO_DURACAO_SEGUNDOS=10

# Som da notificacao.
SOM_ATIVO=true

# Titulo da janela.
TITULO_JANELA=Painel de Acompanhamento de Pedidos
